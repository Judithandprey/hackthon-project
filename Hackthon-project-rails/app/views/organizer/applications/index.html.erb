<div class="workspace"><div class="page-heading"><div><span class="eyebrow">ORGANIZER WORKSPACE</span><h1>A little care. A big opportunity.</h1><p>Meet the people who will make this event happen.</p></div><span class="round-icon">✧</span></div>
  <div class="stats-grid"><div class="stat-card"><span>All applications</span><strong><%= @counts.values.sum %></strong><small>Across both roles</small></div><div class="stat-card"><span>Ready for review</span><strong><%= @counts.fetch('submitted', 0) %></strong><small>Waiting for a first look</small></div><div class="stat-card"><span>In review</span><strong><%= @counts.fetch('under_review', 0) %></strong><small>A decision in progress</small></div><div class="stat-card"><span>Accepted</span><strong><%= @counts.fetch('accepted', 0) %></strong><small>Ready for the next chapter</small></div></div>
  <section class="table-card"><div class="card-heading"><div><h2>Applications</h2><p>Review thoughtfully. Give every application a fair read.</p></div><%= link_to @blind ? "Show identities" : "Enable blind review", organizer_applications_path(blind: @blind ? nil : '1', status: params[:status], role: params[:role]), class: "button secondary" %></div>
    <%= form_with url: organizer_applications_path, method: :get, class: "table-toolbar" do |form| %><%= form.hidden_field :blind, value: params[:blind] %>
      <% unless @blind %><div class="search-field"><%= form.label :q, "Search applicants", class: "sr-only" %><%= form.search_field :q, value: params[:q], placeholder: "Search by name or email…", maxlength: 128 %></div><% end %>
      <%= form.label :status, "Status", class: "sr-only" %><%= form.select :status, [["All statuses", ""]] + HackApplication::STATUSES.map { |s| [status_label(s), s] }, selected: params[:status] %>
      <%= form.label :role, "Role", class: "sr-only" %><%= form.select :role, [["All roles", ""], ["Hacker", "hacker"], ["Mentor", "mentor"]], selected: params[:role] %><%= form.submit "Filter", class: "button secondary" %>
    <% end %>
    <div class="table-scroll"><table><thead><tr><th>Applicant</th><th>Role</th><th>Status</th><th>Score</th><th>Updated (Pacific)</th><th><span class="sr-only">Action</span></th></tr></thead><tbody>
      <% @applications.each do |application| %><tr><td><strong><%= @blind ? "Application ##{application.id}" : application.user.name %></strong><% unless @blind %><small><%= application.user.email %></small><% end %></td><td><span class="role-pill <%= application.user.role %>"><%= application.user.role.capitalize %></span></td><td><span class="badge <%= application.status %>"><%= status_label(application.status) %></span></td><td class="score"><%= application.review ? "#{application.review.total} / 15" : '—' %></td><td class="date"><%= pacific_time(application.updated_at) %></td><td><%= link_to "Review →", organizer_application_path(application, blind: params[:blind]), class: "text-button" %></td></tr><% end %>
    </tbody></table></div>
    <% if @applications.empty? %><div class="empty-state"><span>⌘</span><h3>No applications yet</h3><p>Applications will appear here as applicants save their work.<br>If you applied filters, try clearing them.</p></div><% end %>
    <div class="table-bottom"><span><%= @applications.size %> applications shown</span><span><%= @blind ? 'Blind review is on' : 'Private organizer workspace' %></span></div>
  </section><p class="organizer-note">✧ <strong>Give ideas a fair first look.</strong> Blind review hides names, emails, organizations, and portfolio links. Applicants may still identify themselves in written answers.</p>
</div>

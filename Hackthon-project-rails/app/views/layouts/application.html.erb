<!DOCTYPE html>
<html lang="en">
  <head>
    <title>H@B · Application Portal</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="Apply to join as a hacker or mentor. Save your progress and follow your application.">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="stylesheet" href="/application.css">
    <script src="/application.js" defer></script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="topbar">
      <%= link_to root_path, class: "brand" do %><span class="brand-mark">h↗</span><span>Hackathons<br><strong>@ Berkeley</strong></span><% end %>
      <span class="edition">FALL 2026 / APPLICATION PORTAL</span>
      <nav aria-label="Account" class="account-nav">
        <% if current_user %>
          <span class="account-name"><%= current_user.name %></span>
          <span class="role-pill"><%= current_user.role.capitalize %></span>
          <%= button_to "Sign out ↗", sign_out_path, method: :delete, class: "text-button" %>
        <% else %>
          <%= link_to "Sign in ↗", sign_in_path, class: "text-button" %>
        <% end %>
      </nav>
    </header>
    <main id="main">
      <% flash.each do |type, message| %><div class="flash <%= type == 'alert' ? 'error' : 'success' %>" role="<%= type == 'alert' ? 'alert' : 'status' %>"><%= message %></div><% end %>
      <%= yield %>
    </main>
    <footer><strong>H@B · Fall 2026</strong><span>Independent take-home project by Yisha Tang</span><span>Built with curiosity.</span></footer>
  </body>
</html>
